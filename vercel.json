{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/fortune.html" },
    { "source": "/pay", "destination": "/api/pay" },
    { "source": "/g/:id", "destination": "/fortune.html" },
    { "source": "/g/:id/:name", "destination": "/fortune.html" },
    { "source": "/j/:id", "destination": "/fortune.html" },
    { "source": "/j/:id/:name", "destination": "/fortune.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/fortune.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
