{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/pay", "destination": "/api/pay" }
  ],
  "redirects": [
    { "source": "/", "destination": "/fortune.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/fortune.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
